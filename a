                TextSize = 14,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            addTheme(label, "Text")
            
            local toggle = createInstance("Frame", {
                Parent = container,
                Size = UDim2.new(0, 40, 0, 22),
                Position = UDim2.new(1, -52, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = state and self._themeColors.Accent or self._themeColors.Border,
                BorderSizePixel = 0,
            })
            addTheme(toggle, state and "Accent" or "Border")
            createCorner(11).Parent = toggle
            
            local knob = createInstance("Frame", {
                Parent = toggle,
                Size = UDim2.new(0, 18, 0, 18),
                Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BorderSizePixel = 0,
            })
            createCorner(9).Parent = knob
            
            local btn = createInstance("TextButton", {
                Parent = container,
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
            })
            
            btn.MouseButton1Click:Connect(function()
                state = not state
                local newColor = state and self._themeColors.Accent or self._themeColors.Border
                TS:Create(toggle, TweenInfo.new(0.2), {
                    BackgroundColor3 = newColor,
                }):Play()
                TS:Create(knob, TweenInfo.new(0.2), {
                    Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
                }):Play()
                config.Callback(state)
            end)
            
            return {
                Set = function(v)
                    state = v
                    toggle.BackgroundColor3 = state and self._themeColors.Accent or self._themeColors.Border
                    knob.Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
                    config.Callback(state)
                end,
                Get = function() return state end
            }
        end
        
        local function AddSlider(config)
            config = config or {}
            config.Text = config.Text or "Slider"
            config.Min = config.Min or 0
            config.Max = config.Max or 100
            config.Default = config.Default or 50
            config.Callback = config.Callback or function() end
            
            local value = config.Default
            
            local container = createInstance("Frame", {
                Parent = TabContent,
                Size = UDim2.new(1, 0, 0, 60),
                BackgroundColor3 = self._themeColors.Surface,
                BackgroundTransparency = 0.3,
                BorderSizePixel = 0,
            })
            addTheme(container, "Surface")
            createCorner(6).Parent = container
            
            local label = createInstance("TextLabel", {
                Parent = container,
                Size = UDim2.new(1, -12, 0, 18),
                Position = UDim2.new(0, 12, 0, 6),
                BackgroundTransparency = 1,
                Text = config.Text,
                TextColor3 = self._themeColors.Text,
                TextSize = 14,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            addTheme(label, "Text")
            
            local valueLabel = createInstance("TextLabel", {
                Parent = container,
                Size = UDim2.new(0, 50, 0, 18),
                Position = UDim2.new(1, -62, 0, 6),
                BackgroundTransparency = 1,
                Text = tostring(value),
                TextColor3 = self._themeColors.Accent,
                TextSize = 14,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Right,
            })
            addTheme(valueLabel, "Accent")
            
            local track = createInstance("Frame", {
                Parent = container,
                Size = UDim2.new(1, -24, 0, 4),
                Position = UDim2.new(0, 12, 0, 34),
                BackgroundColor3 = self._themeColors.Border,
                BorderSizePixel = 0,
            })
            addTheme(track, "Border")
            createCorner(2).Parent = track
            
            local fill = createInstance("Frame", {
                Parent = track,
                Size = UDim2.new((value - config.Min) / (config.Max - config.Min), 0, 1, 0),
                BackgroundColor3 = self._themeColors.Accent,
                BorderSizePixel = 0,
            })
            addTheme(fill, "Accent")
            createCorner(2).Parent = fill
            
            local knob = createInstance("Frame", {
                Parent = track,
                Size = UDim2.new(0, 16, 0, 16),
                Position = UDim2.new((value - config.Min) / (config.Max - config.Min), -8, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = self._themeColors.Accent,
                BorderSizePixel = 0,
            })
            addTheme(knob, "Accent")
            createCorner(8).Parent = knob
            
            local dragging = false
            
            local function updateSlider(input)
                local pos = input.Position.X - track.AbsolutePosition.X
                local percent = clamp(pos / track.AbsoluteSize.X, 0, 1)
                local newValue = config.Min + (config.Max - config.Min) * percent
                newValue = round(newValue, 1)
                value = newValue
                
                fill.Size = UDim2.new(percent, 0, 1, 0)
                knob.Position = UDim2.new(percent, -8, 0.5, 0)
                valueLabel.Text = tostring(value)
                config.Callback(value)
            end
            
            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    updateSlider(input)
                end
            end)
            
            UIS.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    updateSlider(input)
                end
            end)
            
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
            
            return {
                Set = function(v)
                    value = clamp(v, config.Min, config.Max)
                    local percent = (value - config.Min) / (config.Max - config.Min)
                    fill.Size = UDim2.new(percent, 0, 1, 0)
                    knob.Position = UDim2.new(percent, -8, 0.5, 0)
                    valueLabel.Text = tostring(value)
                    config.Callback(value)
                end,
                Get = function() return value end
            }
        end
        
        local function AddDropdown(config)
            config = config or {}
            config.Text = config.Text or "Dropdown"
            config.Options = config.Options or {}
            config.Default = config.Default or 1
            config.Callback = config.Callback or function() end
            
            local selected = config.Default
            
            local container = createInstance("Frame", {
                Parent = TabContent,
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = self._themeColors.Surface,
                BackgroundTransparency = 0.3,
                BorderSizePixel = 0,
                ClipsDescendants = true,
            })
            addTheme(container, "Surface")
            createCorner(6).Parent = container
            
            local label = createInstance("TextLabel", {
                Parent = container,
                Size = UDim2.new(1, -50, 1, 0),
                Position = UDim2.new(0, 12, 0, 0),
                BackgroundTransparency = 1,
                Text = config.Text,
                TextColor3 = self._themeColors.Text,
                TextSize = 14,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            addTheme(label, "Text")
            
            local arrow = createInstance("TextLabel", {
                Parent = container,
                Size = UDim2.new(0, 30, 1, 0),
                Position = UDim2.new(1, -35, 0, 0),
                BackgroundTransparency = 1,
                Text = "▾",
                TextColor3 = self._themeColors.TextSecondary,
                TextSize = 16,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Center,
            })
            addTheme(arrow, "TextSecondary")
            
            local selectedLabel = createInstance("TextLabel", {
                Parent = container,
                Size = UDim2.new(0, 120, 1, 0),
                Position = UDim2.new(1, -150, 0, 0),
                BackgroundTransparency = 1,
                Text = tostring(config.Options[selected]),
                TextColor3 = self._themeColors.Accent,
                TextSize = 14,
                Font = Enum.Font.GothamSemibold,
                TextXAlignment = Enum.TextXAlignment.Right,
            })
            addTheme(selectedLabel, "Accent")
            
            local dropdown = createInstance("Frame", {
                Parent = container,
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.new(0, 0, 0, 38),
                BackgroundColor3 = self._themeColors.Surface,
                BorderSizePixel = 0,
                Visible = false,
                ClipsDescendants = true,
            })
            addTheme(dropdown, "Surface")
            
            local dropdownList = createInstance("UIListLayout", {
                Parent = dropdown,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2),
            })
            
            local isOpen = false
            
            local function toggleDropdown()
                isOpen = not isOpen
                dropdown.Visible = true
                if isOpen then
                    container.Size = UDim2.new(1, 0, 0, 38 + (#config.Options * 32))
                    dropdown.Size = UDim2.new(1, 0, 0, #config.Options * 32)
                    arrow.Text = "▴"
                else
                    container.Size = UDim2.new(1, 0, 0, 38)
                    dropdown.Size = UDim2.new(1, 0, 0, 0)
                    arrow.Text = "▾"
                    task.wait(0.2)
                    dropdown.Visible = false
                end
            end
            
            local btn = createInstance("TextButton", {
                Parent = container,
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                ZIndex = 2,
            })
            
            btn.MouseButton1Click:Connect(toggleDropdown)
            
            -- Create options
            for i, option in ipairs(config.Options) do
                local optBtn = createInstance("TextButton", {
                    Parent = dropdown,
                    Size = UDim2.new(1, -4, 0, 30),
                    Position = UDim2.new(0, 2, 0, 0),
                    BackgroundColor3 = self._themeColors.SurfaceHover,
                    BackgroundTransparency = 0.5,
                    Text = tostring(option),
                    TextColor3 = self._themeColors.TextSecondary,
                    TextSize = 14,
                    Font = Enum.Font.Gotham,
                    BorderSizePixel = 0,
                })
                addTheme(optBtn, "SurfaceHover")
                addTheme(optBtn, "TextSecondary")
                createCorner(4).Parent = optBtn
                
                optBtn.MouseButton1Click:Connect(function()
                    selected = i
                    selectedLabel.Text = tostring(option)
                    config.Callback(option, i)
                    if isOpen then toggleDropdown() end
                end)
            end
            
            return {
                Set = function(i)
                    selected = i
                    selectedLabel.Text = tostring(config.Options[i])
                    config.Callback(config.Options[i], i)
                end,
                Get = function() return selected end
            }
        end
        
        local function AddTextbox(config)
            config = config or {}
            config.Text = config.Text or "Textbox"
            config.Placeholder = config.Placeholder or "Type here..."
            config.Callback = config.Callback or function() end
            
            local container = createInstance("Frame", {
                Parent = TabContent,
                Size = UDim2.new(1, 0, 0, 45),
                BackgroundColor3 = self._themeColors.Surface,
                BackgroundTransparency = 0.3,
                BorderSizePixel = 0,
            })
            addTheme(container, "Surface")
            createCorner(6).Parent = container
            
            local label = createInstance("TextLabel", {
                Parent = container,
                Size = UDim2.new(1, -12, 0, 16),
                Position = UDim2.new(0, 12, 0, 4),
                BackgroundTransparency = 1,
                Text = config.Text,
                TextColor3 = self._themeColors.TextSecondary,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            addTheme(label, "TextSecondary")
            
            local box = createInstance("TextBox", {
                Parent = container,
                Size = UDim2.new(1, -24, 0, 22),
                Position = UDim2.new(0, 12, 0, 20),
                BackgroundColor3 = self._themeColors.Background,
                BackgroundTransparency = 0.5,
                Text = "",
                TextColor3 = self._themeColors.Text,
                TextSize = 14,
                Font = Enum.Font.Gotham,
                PlaceholderText = config.Placeholder,
                PlaceholderColor3 = self._themeColors.TextMuted,
                ClearTextOnFocus = false,
                BorderSizePixel = 0,
            })
            addTheme(box, "Background")
            addTheme(box, "Text")
            addTheme(box, "TextMuted")
            createCorner(4).Parent = box
            
            box.FocusLost:Connect(function()
                config.Callback(box.Text)
            end)
            
            return {
                Set = function(v) box.Text = v end,
                Get = function() return box.Text end
            }
        end
        
        -- Return tab interface
        return {
            AddLabel = AddLabel,
            AddButton = AddButton,
            AddToggle = AddToggle,
            AddSlider = AddSlider,
            AddDropdown = AddDropdown,
            AddTextbox = AddTextbox,
        }
    end
    
    -- Store MakeTab function
    windowObj.MakeTab = MakeTab
    
    return windowObj
end

-- ============================================
-- NOTIFICATION SYSTEM
-- ============================================
function ObsidianLib:Notify(config)
    config = config or {}
    config.Title = config.Title or "Notification"
    config.Description = config.Description or ""
    config.Type = config.Type or "info" -- info, success, warning, danger
    config.Duration = config.Duration or 4
    
    local colors = {
        info = { bg = "Surface", accent = "Accent" },
        success = { bg = "Surface", accent = "Success" },
        warning = { bg = "Surface", accent = "Warning" },
        danger = { bg = "Surface", accent = "Danger" },
    }
    
    local c = colors[config.Type] or colors.info
    
    local notif = createInstance("Frame", {
        Name = "Notification",
        Parent = GUI,
        Size = UDim2.new(0, 380, 0, 0),
        Position = UDim2.new(1, -400, 1, -20),
        AnchorPoint = Vector2.new(0, 1),
        BackgroundColor3 = self._themeColors.Surface,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    })
    addTheme(notif, "Surface")
    createCorner(8).Parent = notif
    
    -- Border accent
    local accent = createInstance("Frame", {
        Parent = notif,
        Size = UDim2.new(0, 4, 1, -8),
        Position = UDim2.new(0, 4, 0, 4),
        BackgroundColor3 = self._themeColors[c.accent],
        BorderSizePixel = 0,
    })
    addTheme(accent, c.accent)
    createCorner(2).Parent = accent
    
    local title = createInstance("TextLabel", {
        Parent = notif,
        Size = UDim2.new(1, -20, 0, 24),
        Position = UDim2.new(0, 16, 0, 8),
        BackgroundTransparency = 1,
        Text = config.Title,
        TextColor3 = self._themeColors.Text,
        TextSize = 15,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    addTheme(title, "Text")
    
    local desc = createInstance("TextLabel", {
        Parent = notif,
        Size = UDim2.new(1, -20, 0, 0),
        Position = UDim2.new(0, 16, 0, 32),
        BackgroundTransparency = 1,
        Text = config.Description,
        TextColor3 = self._themeColors.TextSecondary,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
    })
    addTheme(desc, "TextSecondary")
    
    -- Calculate height
    task.wait()
    local height = desc.AbsoluteSize.Y + 40
    notif.Size = UDim2.new(0, 380, 0, height)
    notif.BackgroundTransparency = 0
    
    -- Animate in
    TS:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
        Position = UDim2.new(1, -20, 1, -20 - height),
        BackgroundTransparency = 0,
    }):Play()
    
    -- Auto dismiss
    task.wait(config.Duration)
    TS:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
        Position = UDim2.new(1, 20, 1, -20 - height),
        BackgroundTransparency = 1,
    }):Play()
    task.wait(0.3)
    notif:Destroy()
end

