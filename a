            Button = TabBtn,
            Content = TabContent,
            ContentList = TabContentList,
            Active = false,
            Elements = {},
        }
        
        windowObj.Tabs[tabConfig.Name] = tabData
        table.insert(windowObj.TabOrder, tabConfig.Name)
        
        -- Activate first tab
        if #windowObj.TabOrder == 1 then
            TabBtn.TextColor3 = self._themeColors.Accent
            TabBtn.BackgroundTransparency = 0.1
            TabContent.Visible = true
            isActive = true
            tabData.Active = true
        end
        
