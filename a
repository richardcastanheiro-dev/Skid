    -- ============================================
    local function MakeTab(tabConfig)
        tabConfig = tabConfig or {}
        tabConfig.Name = tabConfig.Name or "Tab"
        tabConfig.Icon = tabConfig.Icon or ""
        
        -- Tab Button
        local TabBtn = createInstance("TextButton", {
            Name = tabConfig.Name,
            Parent = TabContainer,
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = self._themeColors.Surface,
            BackgroundTransparency = 0.5,
            Text = "  " .. tabConfig.Name,
            TextColor3 = self._themeColors.TextSecondary,
            TextSize = 14,
            Font = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Left,
            BorderSizePixel = 0,
        })
        addTheme(TabBtn, "Surface")
        addTheme(TabBtn, "TextSecondary")
        
        -- Tab hover/active effects
        local isActive = false
        
        TabBtn.MouseEnter:Connect(function()
            if not isActive then
                TS:Create(TabBtn, TweenInfo.new(0.2), {
                    BackgroundTransparency = 0.2,
                    TextColor3 = self._themeColors.Text,
                }):Play()
            end
        end)
        
