            TabContent.Size = UDim2.new(1, 0, 0, TabContentList.AbsoluteContentSize.Y + 8)
        end)
        
        -- Tab click
        TabBtn.MouseButton1Click:Connect(function()
            -- Hide all tabs
            for _, tab in pairs(windowObj.Tabs) do
                tab.Button.TextColor3 = self._themeColors.TextSecondary
                tab.Button.BackgroundTransparency = 0.5
                tab.Content.Visible = false
                tab.Active = false
            end
            
            -- Show this tab
