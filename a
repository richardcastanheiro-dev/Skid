            TabBtn.TextColor3 = self._themeColors.Accent
            TabBtn.BackgroundTransparency = 0.1
            TabContent.Visible = true
            
            -- Update canvas
            task.wait()
            ContentArea.CanvasSize = UDim2.new(0, 0, 0, ContentList.AbsoluteContentSize.Y + 24)
        end)
        
