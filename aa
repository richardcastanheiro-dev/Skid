                        local MousePos = Mouse.X
                        local TrackPos = SliderFrame.Track.AbsolutePosition.X
                        local TrackSize = SliderFrame.Track.AbsoluteSize.X
                        local Percent = math.clamp((MousePos - TrackPos) / TrackSize, 0, 1)
                        local Value = Config.Min + (Percent * (Config.Max - Config.Min))
                        SetValue(Value)
                    end
                end)
                
                function SliderData:Set(Value)
                    SetValue(Value)
                end
                
                return SliderData
