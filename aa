                -- Populate options
                for _, Option in ipairs(Config.Values) do
                    local OptionBtn = Create("TextButton", {
                        Parent = DropdownFrame.Options,
                        Size = UDim2.new(1, 0, 0, 28),
                        BackgroundColor3 = Theme.SurfaceHover,
                        Text = Option,
                        TextColor3 = Theme.Text,
                        TextSize = 12,
                        Font = Enum.Font.Gotham,
                        BorderSizePixel = 0,
                        AutoButtonColor = false,
                    }, {
                        Create("UICorner", {CornerRadius = UDim.new(0, 4)}),
                        Create("UIPadding", {PaddingLeft = UDim.new(0, 10)}),
                    })
                    
                    AddConnection(OptionBtn.MouseEnter, function()
                        OptionBtn.BackgroundColor3 = Theme.Accent
                    end)
                    AddConnection(OptionBtn.MouseLeave, function()
                        OptionBtn.BackgroundColor3 = Theme.SurfaceHover
                    end)
                    AddConnection(OptionBtn.MouseButton1Click, function()
                        DropdownData.Value = Option
                        DropdownFrame.Header.Value.Text = Option
                        DropdownData.Open = false
                        TweenService:Create(DropdownFrame, TweenInfo.new(0.15), {Size = UDim2.new(1, 0, 0, 32)}):Play()
                        Config.Callback(Option)
                    end)
                end
                
                -- Toggle dropdown
                AddConnection(DropdownFrame.Header.Clicker.MouseButton1Click, function()
                    DropdownData.Open = not DropdownData.Open
                    local Height = 32 + (#Config.Values * 30)
                    TweenService:Create(DropdownFrame, TweenInfo.new(0.15), {
                        Size = UDim2.new(1, 0, 0, DropdownData.Open and Height or 32)
                    }):Play()
                end)
                
                function DropdownData:Set(Value)
                    DropdownData.Value = Value
                    DropdownFrame.Header.Value.Text = Value
                    Config.Callback(Value)
                end
                
                return DropdownData
            end
            
            -- ADD KEYBIND
            function Section:AddKeybind(Config)
                Config = Config or {}
                Config.Name = Config.Name or "Keybind"
                Config.Default = Config.Default or Enum.KeyCode.None
                Config.Callback = Config.Callback or function() end
                Config.Flag = Config.Flag or nil
                
                local Theme = GetTheme()
                local KeybindData = {
                    Value = Config.Default,
                    Binding = false,
                }
                
                local KeybindFrame = Create("Frame", {
                    Parent = SectionFrame.Content,
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = Theme.Surface,
                    BorderSizePixel = 0,
                }, {
                    Create("UICorner", {CornerRadius = UDim.new(0, 6)}),
                    Create("UIStroke", {Color = Theme.Border, Thickness = 1}),
                    Create("UIPadding", {
                        PaddingLeft = UDim.new(0, 10),
                        PaddingRight = UDim.new(0, 10),
                    }),
                    
                    Create("TextLabel", {
                        Name = "Label",
                        Text = Config.Name,
                        TextColor3 = Theme.Text,
                        TextSize = 13,
                        Font = Enum.Font.GothamSemibold,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, -80, 1, 0),
                        TextXAlignment = Enum.TextXAlignment.Left,
                    }),
                    
                    Create("TextButton", {
                        Name = "KeyDisplay",
                        Size = UDim2.new(0, 70, 0, 24),
                        Position = UDim2.new(1, -4, 0.5, 0),
                        AnchorPoint = Vector2.new(1, 0.5),
                        BackgroundColor3 = Theme.SurfaceHover,
                        Text = Config.Default.Name,
                        TextColor3 = Theme.Text,
                        TextSize = 12,
                        Font = Enum.Font.GothamSemibold,
                        BorderSizePixel = 0,
                        AutoButtonColor = false,
                    }, {
                        Create("UICorner", {CornerRadius = UDim.new(0, 4)}),
                    }),
                })
                
                local function SetKey(Key)
                    KeybindData.Value = Key
                    KeybindFrame.KeyDisplay.Text = Key.Name
                    KeybindData.Binding = false
                    KeybindFrame.KeyDisplay.BackgroundColor3 = Theme.SurfaceHover
                end
                
                AddConnection(KeybindFrame.KeyDisplay.MouseButton1Click, function()
                    KeybindData.Binding = true
                    KeybindFrame.KeyDisplay.Text = "..."
                    KeybindFrame.KeyDisplay.BackgroundColor3 = Theme.Accent
                end)
                
                AddConnection(UserInputService.InputBegan, function(Input)
                    if KeybindData.Binding then
                        if Input.KeyCode ~= Enum.KeyCode.Unknown then
                            SetKey(Input.KeyCode)
                            Config.Callback(Input.KeyCode)
                        elseif Input.UserInputType == Enum.UserInputType.MouseButton1 then
                            SetKey(Input.UserInputType)
                            Config.Callback(Input.UserInputType)
                        end
                    end
                    
                    -- Trigger callback when key is pressed
                    if not KeybindData.Binding and Input.KeyCode == KeybindData.Value then
                        Config.Callback()
                    end
                end)
                
                function KeybindData:Set(Key)
                    SetKey(Key)
                end
                
                return KeybindData
            end
            
            -- ADD LABEL
            function Section:AddLabel(Text)
                local Theme = GetTheme()
                
                return Create("TextLabel", {
                    Parent = SectionFrame.Content,
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = Text,
                    TextColor3 = Theme.TextDim,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Center,
                })
            end
            
            return Section
        end
        
        return Tab
    end
    
    table.insert(Windows, Window)
    return Window
end

