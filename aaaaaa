-- ================================
function ObsidianLib:SaveConfig()
    if not ObsidianLib.Folder or not ObsidianLib.SaveCfg then return end
    
    local Data = {}
    for i, v in pairs(ObsidianLib.Flags) do
        if v.Save then
            if v.Type == "MultiColorpicker" then
                if v.Pickers and #v.Pickers > 0 then
                    local colorList = {}
                    for index, picker in ipairs(v.Pickers) do
                        colorList[index] = PackColor(picker.Value)
                    end
                    Data[i] = colorList
                end
            elseif v.Type == "Colorpicker" then
                if v.Pickers and v.Pickers[1] then
                    Data[i] = PackColor(v.Pickers[1].Value)
                else
                    Data[i] = PackColor(v.Value)
                end
            else
                Data[i] = v.Value
            end
        end
    end
    
    local filePath = ObsidianLib.Folder .. "/" .. game.GameId .. ".json"
    writefile(filePath, HttpService:JSONEncode(Data))
end

function ObsidianLib:LoadConfig()
    if not ObsidianLib.Folder or not ObsidianLib.SaveCfg then return end
    
    local filePath = ObsidianLib.Folder .. "/" .. game.GameId .. ".json"
    if not isfile(filePath) then return end
    
    local Data = HttpService:JSONDecode(readfile(filePath))
    for key, value in pairs(Data) do
        local flag = ObsidianLib.Flags[key]
        if flag then
            if flag.Type == "MultiColorpicker" then
                if type(value) == "table" and value.R == nil then
                    for index, colorData in ipairs(value) do
                        flag:Set(index, UnpackColor(colorData))
                    end
                else
                    flag:Set(1, UnpackColor(value))
                end
            elseif flag.Type == "Colorpicker" then
                flag:Set(UnpackColor(value))
            elseif flag.Type == "Bind" then
                local success, keyEnum = pcall(function()
                    return Enum.KeyCode[value] or Enum.UserInputType[value]
                end)
                if success and keyEnum then
                    flag:Set(keyEnum)
                else
                    flag:Set(value)
                end
            else
                flag:Set(value)
            end
        end
    end
end

