    -- Aplicar tema
    local function ApplyWindowTheme()
        local theme = ObsidianLib.Themes[ObsidianLib.SelectedTheme]
        if not theme then return end
        
        MainWindow.BackgroundColor3 = theme.Main
        if MainWindow:FindFirstChild("UIStroke") then
            MainWindow.UIStroke.Color = theme.Border
        end
        
        local topBar = MainWindow:FindFirstChild("TopBar")
        if topBar then
            topBar.BackgroundColor3 = theme.Surface
            topBar.Title.TextColor3 = theme.Text
            topBar.Icon.ImageColor3 = theme.Accent
        end
    end
    ApplyWindowTheme()
    
    -- Tornar arrastável
    MakeDraggable(MainWindow.DragPoint, MainWindow)
    
