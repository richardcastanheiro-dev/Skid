local function GetIcon(IconName)
    local Icons = {}
    local Success, Response = pcall(function()
        Icons = HttpService:JSONDecode(game:HttpGetAsync("https://raw.githubusercontent.com/evoincorp/lucideblox/master/src/modules/util/icons.json")).icons
    end)
    if Success and Icons[IconName] then
        return Icons[IconName]
    end
    return nil
end

local function Create(Name, Properties, Children)
    local Object = Instance.new(Name)
    for i, v in next, Properties or {} do
        Object[i] = v
    end
    for i, v in next, Children or {} do
        v.Parent = Object
    end
    return Object
end

local function Round(Number, Factor)
    local Result = math.floor(Number/Factor + (math.sign(Number) * 0.5)) * Factor
    if Result < 0 then Result = Result + Factor end
    return Result
end

local function PackColor(Color)
    if typeof(Color) ~= "Color3" then return nil end
    return {R = Color.R * 255, G = Color.G * 255, B = Color.B * 255}
end

local function UnpackColor(Color)
    if not Color or not Color.R then return Color3.fromRGB(255, 255, 255) end
    return Color3.fromRGB(Color.R, Color.G, Color.B)
end

local function CheckKey(Table, Key)
    for _, v in next, Table do
        if v == Key then
            return true
        end
    end
    return false
end

local function AddConnection(Signal, Function)
    local SignalConnect = Signal:Connect(Function)
    table.insert(ObsidianLib.Connections, SignalConnect)
    return SignalConnect
end

local function ReturnProperty(Object)
    if Object:IsA("Frame") or Object:IsA("TextButton") then
        return "BackgroundColor3"
    end
    if Object:IsA("ScrollingFrame") then
        return "ScrollBarImageColor3"
    end
    if Object:IsA("UIStroke") then
        return "Color"
    end
    if Object:IsA("TextLabel") or Object:IsA("TextBox") then
        return "TextColor3"
    end
    if Object:IsA("ImageLabel") or Object:IsA("ImageButton") then
        return "ImageColor3"
    end
    return nil
end

local function AddThemeObject(Object, Type)
    if not ObsidianLib.ThemeObjects[Type] then
        ObsidianLib.ThemeObjects[Type] = {}
    end
    table.insert(ObsidianLib.ThemeObjects[Type], Object)
    local themeColor = ObsidianLib.Themes[ObsidianLib.SelectedTheme][Type]
    local property = ReturnProperty(Object)
    if themeColor and property and Object[property] ~= nil then
        Object[property] = themeColor
    end
    return Object
end

local function lighterHSV(color: Color3, factor: number)
    factor = math.clamp(factor, 0, 1)
    local h, s, v = color:ToHSV()
    v = math.clamp(v + factor, 0, 1)
    s = math.clamp(s * (1 - factor * 0.25), 0, 1)
    return Color3.fromHSV(h, s, v)
end

local function darkerColor(color, factor)
    factor = math.clamp(factor, 0, 1)
    return Color3.new(color.R * factor, color.G * factor, color.B * factor)
end

local function createGradientFromColor(baseColor, darkFactor)
    local dark = darkerColor(baseColor, darkFactor)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, baseColor),
        ColorSequenceKeypoint.new(0.5, dark),
        ColorSequenceKeypoint.new(1, baseColor),
    })
end

-- ================================
-- SISTEMA DE TEMAS
-- ================================
function ObsidianLib:SetTheme(themeName)
    if themeName and ObsidianLib.Themes[themeName] then
        ObsidianLib.SelectedTheme = themeName
    end
    
    local themeData = ObsidianLib.Themes[ObsidianLib.SelectedTheme]
    if not themeData then return end
    
    for typeName, objects in pairs(ObsidianLib.ThemeObjects) do
        local color = themeData[typeName]
        if color then
            for _, obj in ipairs(objects) do
                local prop = ReturnProperty(obj)
                if prop and obj[prop] ~= nil then
                    obj[prop] = color
                end
            end
        end
    end
    
    -- Atualizar toggles
    for _, toggle in ipairs(ObsidianLib.Toggles) do
        if toggle and toggle.Box and toggle.Box.Parent then
            local activeTheme = ObsidianLib.Themes[ObsidianLib.SelectedTheme]
            local accolor = toggle.uccolor and toggle.ccolor or activeTheme.Accent
            
            if toggle.Value then
                TweenService:Create(toggle.Box, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {BackgroundColor3 = accolor}):Play()
                if toggle.Box:FindFirstChild("Stroke") then
                    TweenService:Create(toggle.Box.Stroke, TweenInfo.new(0.1), {Color = accolor}):Play()
                end
            else
                TweenService:Create(toggle.Box, TweenInfo.new(0.1), {BackgroundColor3 = activeTheme.Surface}):Play()
                if toggle.Box:FindFirstChild("Stroke") then
                    TweenService:Create(toggle.Box.Stroke, TweenInfo.new(0.1), {Color = activeTheme.Border}):Play()
                end
            end
        end
    end
    
    -- Salvar tema customizado
    ObsidianLib:SaveThemeCfg()
end

