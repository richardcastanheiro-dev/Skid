    Config.Theme = Config.Theme or "Default"
    Config.KeyToOpen = Config.KeyToOpen or "RightShift"
    Config.FreeMouse = Config.FreeMouse or false
    Config.Icon = Config.Icon or "rbxassetid://8834748103"
    
    ObsidianLib.Folder = Config.ConfigFolder
    ObsidianLib.SaveCfg = Config.SaveConfig
    ObsidianLib.SelectedTheme = Config.Theme
    
    if Config.SaveConfig and not isfolder(Config.ConfigFolder) then
        makefolder(Config.ConfigFolder)
    end
    
    -- Criar holder de notificações
    local notificationHolderClone = NotificationHolder:Clone()
    notificationHolderClone.Parent = Orion
    
