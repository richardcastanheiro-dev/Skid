local THEME_FOLDER = "ObsidianTheme"
local FILE_PATH = THEME_FOLDER .. "/" .. game.GameId .. ".json"

if not isfolder(THEME_FOLDER) then
    makefolder(THEME_FOLDER)
end

function ObsidianLib:SaveThemeCfg()
    local themeData = ObsidianLib.Themes[ObsidianLib.SelectedTheme]
    if not themeData then return end
    
    local Data = {}
    for typeName, value in pairs(themeData) do
        if typeof(value) == "Color3" then
            Data[typeName] = PackColor(value)
        end
    end
    
    writefile(FILE_PATH, HttpService:JSONEncode(Data))
end

function ObsidianLib:LoadThemeCfg()
    if not isfile(FILE_PATH) then return end
    
    local Data = HttpService:JSONDecode(readfile(FILE_PATH))
    ObsidianLib.Themes.Custom = {}
    for TypeName, Value in pairs(Data) do
        ObsidianLib.Themes.Custom[TypeName] = UnpackColor(Value)
    end
    ObsidianLib.SelectedTheme = "Custom"
    ObsidianLib:SetTheme()
end

